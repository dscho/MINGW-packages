From 8753ca1c0f4e4531fc3ec4e82ad5d4120975976b Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johannes.schindelin@gmx.de>
Date: Thu, 30 Jun 2022 15:05:22 +0200
Subject: [PATCH 1/6] gz_open(): special-case `/dev/null`

On Windows, it's `NUL`...

Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 gzlib.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/gzlib.c b/gzlib.c
index e1290fc..e67c83b 100644
--- a/gzlib.c
+++ b/gzlib.c
@@ -53,6 +53,9 @@ static gzFile gz_open(const void *path, int fd, const char *mode) {
     if (path == NULL)
         return NULL;
 
+    if (!strcmp("/dev/null", path))
+	    path = "NUL";
+
     /* allocate gzFile structure to return */
     state = (gz_state *)zng_alloc(sizeof(gz_state));
     if (state == NULL)
